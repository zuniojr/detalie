---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, ogType, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Pular para conteúdo</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <FloatingCTA />
  </body>
</html>
