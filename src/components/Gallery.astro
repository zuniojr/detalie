---
import { Image } from 'astro:assets';
import { CATEGORIES } from '../utils/constants';
import SectionTitle from './SectionTitle.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/images/*.{jpeg,jpg,png,gif,webp}');

interface Props {
  limit?: number;
  offset?: number;
  showTitle?: boolean;
}

const { limit, offset = 0, showTitle = true } = Astro.props;
const displayCategories = limit
  ? CATEGORIES.slice(offset, offset + limit)
  : CATEGORIES.slice(offset);
---

<section class="gallery-section">
  <div class="container">
    {showTitle && (
      <SectionTitle
        pretitle="Nossas Especialidades"
        title="Ambientes Planejados Sob Medida"
        subtitle="Soluções inteligentes e exclusivas desenvolvidas para cada espaço da sua casa ou empresa."
      />
    )}

    <div class="gallery-grid">
      {displayCategories.map((cat) => {
        const imagePath = `../assets/images/${cat.img}`;
        const imagePromise = images[imagePath];
        if (!imagePromise) throw new Error(`Image not found: ${imagePath}`);
        
        return (
          <a href={`/produtos-e-servicos#${cat.slug}`} class="gallery-card">
            <div class="gallery-img-wrap">
              <Image
                src={imagePromise()}
                alt={cat.name}
                loading="lazy"
                width={400}
                height={300}
              />
              <div class="gallery-card-overlay">
              <span class="gallery-card-btn">Ver Ambientes</span>
            </div>
          </div>
          <h3 class="gallery-label">{cat.name}</h3>
        </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: var(--spacing-lg) 0;
    background-color: var(--color-white);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: var(--transition);
  }

  .gallery-img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 4 / 3;
    background-color: var(--color-sand);
    box-shadow: var(--shadow-sm);
  }

  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .gallery-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 26, 23, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-card-btn {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-white);
    padding: 0.6rem 1.25rem;
    border: 1px solid var(--color-accent);
    background: rgba(197, 164, 109, 0.85);
    border-radius: var(--radius-sm);
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .gallery-card:hover .gallery-img-wrap img {
    transform: scale(1.08);
  }

  .gallery-card:hover .gallery-card-overlay {
    opacity: 1;
  }

  .gallery-card:hover .gallery-card-btn {
    transform: translateY(0);
  }

  .gallery-label {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: 0.5px;
    margin-top: 1rem;
    text-transform: uppercase;
    text-align: center;
    transition: var(--transition-fast);
  }

  .gallery-card:hover .gallery-label {
    color: var(--color-accent);
  }

  @media (max-width: 992px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 576px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .gallery-section {
      padding: var(--spacing-md) 0;
    }
  }
</style>
