---
import { Image } from 'astro:assets';
import { COMPANY, CONTACT } from '../utils/constants';
import heroImage from '../assets/images/hero.webp';
import WhatsAppIcon from './WhatsAppIcon.astro';

const whatsappUrl = CONTACT.whatsappMessage('móveis planejados');
---

<section class="hero" aria-label="Apresentação">
  <Image 
    src={heroImage} 
    alt="Ambiente com móveis planejados"
    class="hero-bg-img"
    fetchpriority="high"
    loading="eager"
  />
  <div class="hero-bg-overlay"></div>
  <div class="container hero-container">
    <div class="hero-card animate-fade-in-up">
      <span class="hero-badge">Excelência & Sofisticação</span>
      <h1 class="hero-title">
        MÓVEIS <span class="highlight">PLANEJADOS</span>
      </h1>
      <p class="hero-subtitle">
        {COMPANY.slogan}
      </p>
      <div class="hero-actions">
        <a
          href="https://bitlybr.net/Detalie"
          class="btn btn-whatsapp hero-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <WhatsAppIcon size={22} />
          Quero um Orçamento Grátis
        </a>

      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 0;
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(4, 5, 6, 0.88) 0%,
      rgba(4, 5, 6, 0.7) 50%,
      rgba(4, 5, 6, 0.4) 100%
    );
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
    width: 100%;
  }

  .hero-card {
    max-width: 620px;
    background: transparent;
    backdrop-filter: none;
    border: none;
    padding: 3rem 0;
    border-radius: 0;
    box-shadow: none;
    text-align: left;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    background: rgba(197, 164, 109, 0.12);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(197, 164, 109, 0.3);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: var(--font-hero);
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 800;
    color: var(--color-white);
    line-height: 1.1;
    letter-spacing: 1px;
    margin-bottom: 1.25rem;
  }

  .hero-title .highlight {
    color: var(--color-accent);
    position: relative;
  }

  .hero-subtitle {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .hero-btn {
    font-size: 0.95rem;
    padding: 0.95rem 2rem;
  }

  .hero-btn-secondary {
    font-size: 0.95rem;
    padding: 0.95rem 1.75rem;
  }

  @media (max-width: 992px) {
    .hero-container {
      justify-content: center;
    }

    .hero-card {
      max-width: 100%;
      text-align: center;
      padding: 2.5rem 1.5rem;
    }

    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 576px) {
    .hero {
      min-height: 75vh;
    }

    .hero-card {
      padding: 2rem 1.25rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
