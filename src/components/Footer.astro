---
import { Image } from 'astro:assets';
import { COMPANY, CONTACT, ADDRESS, SOCIAL, NAV_LINKS, LEGAL_LINKS } from '../utils/constants';
import logoImg from '../assets/images/logo.png';
---

<footer class="footer">
  <div class="container footer-content">
    <!-- Coluna 1: Sobre e Logo -->
    <div class="footer-col brand-col">
      <a href="/" aria-label={COMPANY.name}>
        <Image src={logoImg} alt={COMPANY.name} width={180} height={60} loading="lazy" />
      </a>
      <p class="brand-desc">{COMPANY.slogan}</p>
      
      <!-- Redes Sociais -->
      <div class="social-links" aria-label="Redes Sociais">
        <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href={SOCIAL.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-0.981z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Coluna 2: Links Rápidos -->
    <div class="footer-col">
      <h3>Navegação</h3>
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Coluna 3: Contato & Localização -->
    <div class="footer-col">
      <h3>Atendimento</h3>
      <ul class="contact-list">
        <li>
          <span class="icon">📞</span>
          <a href={CONTACT.phoneTel}>{CONTACT.phone}</a>
        </li>
        <li>
          <span class="icon">✉️</span>
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </li>
        <li>
          <span class="icon">📍</span>
          <a href={ADDRESS.googleMapsUrl} target="_blank" rel="noopener noreferrer">
            {ADDRESS.full}
          </a>
        </li>
        <li>
          <span class="icon">🕒</span>
          <span>Seg a Sex: 08h às 18h | Sáb: 08h às 12h</span>
        </li>
      </ul>
    </div>

    <!-- Coluna 4: Institucional & Legal -->
    <div class="footer-col">
      <h3>Institucional</h3>
      <ul>
        {LEGAL_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {new Date().getFullYear()} {COMPANY.name}. Todos os direitos reservados.</p>
      <p class="credits">Móveis Sob Medida em Navegantes e Região</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding-top: var(--spacing-xl);
    border-top: 3px solid var(--color-accent);
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.2fr 1fr;
    gap: 2.5rem;
    padding-bottom: var(--spacing-lg);
  }

  .footer-col h3 {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1.25rem;
  }

  .brand-desc {
    color: var(--color-gray-medium);
    font-size: 0.9rem;
    margin: 1rem 0 1.5rem 0;
    line-height: 1.5;
  }

  .social-links {
    display: flex;
    gap: 1rem;
  }

  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    transition: var(--transition-fast);
  }

  .social-links a:hover {
    background: var(--color-accent);
    color: var(--color-primary);
    transform: translateY(-3px);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col a {
    color: var(--color-text-light);
    font-size: 0.9rem;
    transition: var(--transition-fast);
  }

  .footer-col a:hover {
    color: var(--color-accent);
    padding-left: 4px;
  }

  .contact-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .contact-list .icon {
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .footer-bottom {
    background-color: var(--color-black);
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
    color: var(--color-gray-medium);
  }

  .footer-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (max-width: 992px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
