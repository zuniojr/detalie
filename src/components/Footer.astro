---
import { Image } from 'astro:assets';
import { COMPANY, CONTACT, ADDRESS, SOCIAL, LEGAL_LINKS } from '../utils/constants';
import logoImg from '../assets/images/logo.png';

const currentYear = new Date().getFullYear();

const ambientes = [
  { label: 'Cozinhas Planejadas', href: '/produtos-e-servicos#cozinha-sob-medida' },
  { label: 'Dormitórios', href: '/produtos-e-servicos#dormitorio' },
  { label: 'Closets', href: '/produtos-e-servicos#closets' },
  { label: 'Home Office', href: '/produtos-e-servicos#home-office' },
  { label: 'Banheiros', href: '/produtos-e-servicos#banheiro' },
  { label: 'Lavanderias', href: '/produtos-e-servicos#lavanderia' },
  { label: 'Espaço Gourmet', href: '/produtos-e-servicos#espaco-gourmet' },
  { label: 'Painéis Ripados', href: '/produtos-e-servicos#paineis-ripados' },
  { label: 'Corporativo', href: '/produtos-e-servicos#corporativo' },
];

const institucional = [
  { label: 'Home', href: '/' },
  { label: 'Sobre Nós', href: '/quem-somos' },
  { label: 'Projetos', href: '/produtos-e-servicos' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contato', href: '/contato' },
  { label: 'Trabalhe Conosco', href: '/trabalhe-conosco' },
];

const diferenciais = [
  {
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Projeto Personalizado',
    desc: 'Cada ambiente planejado de forma exclusiva para você',
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Materiais Premium',
    desc: 'Marcas renomadas com durabilidade e sofisticação',
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: 'Entrega no Prazo',
    desc: 'Cumprimos nossos compromissos com pontualidade',
  },
  {
    icon: `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`,
    title: 'Garantia de Qualidade',
    desc: 'Acabamento impecável e satisfação garantida',
  },
];
---

<!-- CTA Banner -->
<section class="footer-cta" aria-label="Seção de chamada para ação">
  <div class="container footer-cta-inner">
    <div class="footer-cta-text">
      <h2 class="footer-cta-title">Vamos transformar seu ambiente?</h2>
      <p class="footer-cta-desc">
        Solicite um orçamento gratuito e descubra como um projeto personalizado pode valorizar sua casa ou empresa.
      </p>
    </div>
    <div class="footer-cta-actions">
      <a
        href="https://bitlybr.net/Detalie"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta btn-cta-primary"
        id="footer-cta-orcamento"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        Solicitar Orçamento
      </a>
      <a
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta btn-cta-ghost"
        id="footer-cta-whatsapp"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>

<!-- Diferenciais Strip -->
<section class="footer-diferenciais" aria-label="Nossos diferenciais">
  <div class="container">
    <div class="diferenciais-grid">
      {diferenciais.map((d, i) => (
        <div class="diferencial-card" style={`animation-delay: ${i * 0.1}s`}>
          <span class="diferencial-icon" set:html={d.icon} aria-hidden="true" />
          <div class="diferencial-text">
            <strong class="diferencial-title">✔ {d.title}</strong>
            <p class="diferencial-desc">{d.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Footer Principal -->
<footer class="footer" role="contentinfo">
  <div class="container footer-grid">

    <!-- Coluna 1: Brand -->
    <div class="footer-col footer-col--brand">
      <a href="/" class="footer-logo-link" aria-label={`Página inicial — ${COMPANY.name}`}>
        <Image
          src={logoImg}
          alt={COMPANY.name}
          width={190}
          height={64}
          loading="lazy"
          class="footer-logo"
        />
      </a>
      <p class="footer-brand-desc">
        Transformamos ambientes em espaços únicos através de móveis planejados sob medida, unindo design, funcionalidade e acabamento impecável.
      </p>
      <a
        href="https://bitlybr.net/Detalie"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-footer-primary"
        id="footer-orcamento-btn"
      >
        Solicitar Orçamento
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>

    <!-- Coluna 2: Institucional -->
    <nav class="footer-col" aria-label="Links institucionais">
      <h3 class="footer-heading">Institucional</h3>
      <ul class="footer-list">
        {institucional.map((item) => (
          <li>
            <a href={item.href} class="footer-link">
              <span class="footer-link-arrow" aria-hidden="true">›</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Coluna 3: Ambientes -->
    <nav class="footer-col" aria-label="Ambientes planejados">
      <h3 class="footer-heading">Ambientes</h3>
      <ul class="footer-list">
        {ambientes.map((item) => (
          <li>
            <a href={item.href} class="footer-link">
              <span class="footer-link-arrow" aria-hidden="true">›</span>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Coluna 4: Contato -->
    <address class="footer-col" style="font-style: normal;">
      <h3 class="footer-heading">Contato</h3>
      <ul class="footer-contact-list">
        <li class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
          </span>
          <span>
            {ADDRESS.street}<br />
            {ADDRESS.neighborhood} — {ADDRESS.city}/{ADDRESS.state}
          </span>
        </li>
        <li class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
          </span>
          <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link">
            WhatsApp: {CONTACT.phone}
          </a>
        </li>
        <li class="footer-contact-item">
          <span class="footer-contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </span>
          <span>Segunda a Sexta<br />08:00 às 18:00</span>
        </li>
      </ul>
      <a
        href={ADDRESS.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-footer-maps"
        id="footer-maps-btn"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
        </svg>
        Abrir no Google Maps
      </a>
    </address>

    <!-- Coluna 5: Redes Sociais -->
    <div class="footer-col footer-col--social">
      <h3 class="footer-heading">Siga-nos</h3>
      <p class="footer-social-desc">Acompanhe nossos projetos e inspirações nas redes sociais.</p>
      <div class="footer-social-icons" role="list">
        <a
          href={SOCIAL.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-btn"
          id="footer-instagram-btn"
          role="listitem"
          aria-label="Instagram da Detaliê Móveis"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a
          href={SOCIAL.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-btn"
          id="footer-facebook-btn"
          role="listitem"
          aria-label="Facebook da Detaliê Móveis"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a
          href={CONTACT.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-btn"
          id="footer-whatsapp-social-btn"
          role="listitem"
          aria-label="WhatsApp da Detaliê Móveis"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>

  <!-- Linha separadora -->
  <div class="footer-divider" role="separator" aria-hidden="true"></div>

  <!-- Barra inferior -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copyright">
        &copy; {currentYear} {COMPANY.name}. Todos os direitos reservados.
      </p>
      <nav class="footer-legal-links" aria-label="Links legais">
        {LEGAL_LINKS.filter(l => l.href !== '/trabalhe-conosco').map((link) => (
          <a href={link.href} class="footer-legal-link">{link.label}</a>
        ))}
      </nav>
      <p class="footer-credits">
        Desenvolvido com <span aria-label="amor">❤️</span> para transformar ambientes.
      </p>
    </div>
  </div>
</footer>

<script>
  // Intersection Observer — animação ao entrar na viewport
  function initFooterAnimations() {
    const targets = document.querySelectorAll('.diferencial-card, .footer-col, .footer-cta-inner');
    if (!targets.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    targets.forEach((el) => observer.observe(el));
  }

  initFooterAnimations();
  document.addEventListener('astro:page-load', initFooterAnimations);
</script>

<style>
  /* ============================================
     CTA BANNER
  ============================================ */
  .footer-cta {
    background: linear-gradient(135deg, #1C1A17 0%, #2A2724 60%, #1C1A17 100%);
    border-top: 1px solid rgba(197, 164, 109, 0.2);
    border-bottom: 1px solid rgba(197, 164, 109, 0.15);
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }

  .footer-cta::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      radial-gradient(ellipse 60% 80% at 20% 50%, rgba(197,164,109,0.06) 0%, transparent 70%),
      radial-gradient(ellipse 60% 80% at 80% 50%, rgba(197,164,109,0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .footer-cta-inner.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .footer-cta-text {
    flex: 1;
    max-width: 620px;
  }

  .footer-cta-title {
    font-family: var(--font-section);
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
    line-height: 1.15;
  }

  .footer-cta-desc {
    color: rgba(229, 227, 223, 0.75);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0;
  }

  .footer-cta-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.9rem 2rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
    min-width: 220px;
  }

  .btn-cta-primary {
    background: linear-gradient(135deg, #C5A46D 0%, #D4B57C 100%);
    color: #111111;
    box-shadow: 0 4px 18px rgba(197,164,109,0.35);
  }

  .btn-cta-primary:hover {
    background: linear-gradient(135deg, #cbb18a 0%, #D4B57C 100%);
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(197,164,109,0.45);
  }

  .btn-cta-ghost {
    background: transparent;
    color: var(--color-white);
    border: 1.5px solid rgba(255,255,255,0.3);
  }

  .btn-cta-ghost:hover {
    border-color: #C5A46D;
    color: #C5A46D;
    transform: translateY(-3px);
  }

  /* ============================================
     DIFERENCIAIS STRIP
  ============================================ */
  .footer-diferenciais {
    background: #0E0D0B;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(197,164,109,0.12);
  }

  .diferenciais-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .diferencial-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 2rem;
    border-right: 1px solid rgba(255,255,255,0.06);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease, background 0.25s ease;
  }

  .diferencial-card:last-child {
    border-right: none;
  }

  .diferencial-card.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  .diferencial-card:hover {
    background: rgba(197,164,109,0.05);
  }

  .diferencial-icon {
    color: #C5A46D;
    flex-shrink: 0;
    margin-top: 2px;
    transition: transform 0.3s ease;
  }

  .diferencial-card:hover .diferencial-icon {
    transform: scale(1.15);
  }

  .diferencial-title {
    display: block;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-white);
    letter-spacing: 0.3px;
    margin-bottom: 0.3rem;
  }

  .diferencial-desc {
    font-size: 0.8rem;
    color: rgba(144,144,146,0.85);
    line-height: 1.45;
    margin: 0;
  }

  /* ============================================
     FOOTER PRINCIPAL
  ============================================ */
  .footer {
    background: #111111;
    color: var(--color-text-light);
    padding-top: 4.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1.3fr 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
  }

  /* Colunas */
  .footer-col {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .footer-col.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Heading */
  .footer-heading {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #C5A46D;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(197,164,109,0.2);
  }

  /* Brand col */
  .footer-logo {
    width: 190px;
    height: auto;
    display: block;
    margin-bottom: 1.25rem;
  }

  .footer-brand-desc {
    font-size: 0.88rem;
    color: rgba(229,227,223,0.6);
    line-height: 1.7;
    margin-bottom: 1.75rem;
  }

  .btn-footer-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, #C5A46D 0%, #D4B57C 100%);
    color: #111111;
