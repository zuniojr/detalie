---
const differentials = [
  {
    // Ícone de Camadas/Variedade de Materiais
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 12l10 5 10-5"/><path d="M2 17l10 5 10-5"/></svg>`,
    title: "Variedade de Produtos",
    text: "Ampla variedade de materiais, além de móveis planejados feitos sob medida e diversas opções de cores e layout."
  },
  {
    // Ícone de Relógio de Agilidade e Prazo
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/><path d="m19 19 2 2"/></svg>`,
    title: "Prazo de Entrega",
    text: "Um dos diferenciais da Detaliê Móveis Sob Medida é o seu compromisso com o prazo de entrega. A empresa trabalha com agilidade e eficiência para garantir que os projetos sejam entregues no prazo estabelecido, evitando atrasos e transtornos para os clientes."
  },
  {
    // Ícone de Atendimento Especializado / Consultoria
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/></svg>`,
    title: "Atendimento Especializado",
    text: "Nossa equipe de especialistas disponibiliza um atendimento personalizado para auxiliar na definição dos melhores produtos para sua casa. Com atenção aos detalhes e um compromisso com a satisfação do cliente, a Detaliê Móveis Sob Medida busca superar as expectativas em cada projeto."
  },
  {
    // Ícone de Pagamento Facilitado
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><path d="M6 15h4"/></svg>`,
    title: "Pagamento Facilitado",
    text: "Temos como um dos nossos diferenciais oferecer preços competitivos no mercado, sem abrir mão da qualidade dos nossos produtos e serviços. Além disso, buscamos facilitar as condições de pagamento, oferecendo opções variadas que se adequam às necessidades de cada cliente."
  },
  {
    // Ícone de Projeto Sob Medida (Esquadro / Arquitetura)
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2 2"/><path d="m11.5 9.5 2 2"/><path d="m8.5 6.5 2 2"/></svg>`,
    title: "Projetos Sob Medida",
    text: "Nossos projetos são personalizados para atender às necessidades específicas de cada cliente. Trabalhamos em estreita colaboração com os clientes para criar soluções sob medida que se adaptem ao seu estilo de vida e orçamento."
  },
  {
    // Ícone de Garantia (Escudo com Selo de Qualidade)
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
    title: "Garantia Diferenciada",
    text: "Oferecemos garantia diferenciada em nossos produtos e serviços, assegurando a qualidade e durabilidade dos materiais utilizados em nossos projetos. A Detaliê Móveis Sob Medida trabalha com os melhores fornecedores do mercado, que oferecem produtos de alta qualidade."
  }
];
---

<section class="differentials-section" id="diferenciais">
  <div class="container">
    <div class="section-header">
      <span class="subtitle">A VARIEDADE QUE VOCÊ PRECISA PARA DECORAR SEU ESPAÇO</span>
      <h2 class="section-title">DIFERENCIAIS DA DETALIÊ</h2>
    </div>
    
    <div class="differentials-grid">
      {differentials.map((diff) => (
        <div class="differential-card">
          <div class="icon-wrapper" set:html={diff.icon} />
          <h3 class="card-title">{diff.title}</h3>
          <p class="card-text">{diff.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .differentials-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
  }
  
  .subtitle {
    display: block;
    font-size: 0.85rem;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
  }
  
  .section-title {
    font-family: var(--font-section);
    font-size: 2.5rem;
    color: var(--color-black);
    margin: 0;
    letter-spacing: 1px;
  }
  
  .differentials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }
  
  .differential-card {
    text-align: center;
    padding: 1.5rem 1rem;
    border-radius: var(--radius-lg);
    transition: transform 0.3s ease;
  }
  
  .icon-wrapper {
    width: 72px;
    height: 72px;
    margin: 0 auto 1.5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(197, 164, 109, 0.1);
    border: 1px solid rgba(197, 164, 109, 0.3);
    border-radius: 50%;
    color: #cbb18a;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .icon-wrapper :global(svg) {
    width: 32px;
    height: 32px;
    transition: transform 0.3s ease;
  }
  
  .differential-card:hover .icon-wrapper {
    background: var(--color-black);
    color: #cbb18a;
    border-color: var(--color-black);
    transform: translateY(-6px) scale(1.08);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }
  
  .differential-card:hover .icon-wrapper :global(svg) {
    transform: scale(1.1);
  }
  
  .card-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.75rem;
    transition: color 0.2s ease;
  }
  
  .differential-card:hover .card-title {
    color: var(--color-accent);
  }
  
  .card-text {
    font-size: 0.92rem;
    color: var(--color-gray-medium);
    line-height: 1.75;
  }
  
  @media (max-width: 992px) {
    .differentials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
  
  @media (max-width: 768px) {
    .differentials-grid {
      grid-template-columns: 1fr;
    }
    
    .section-title {
      font-size: 2rem;
    }
    
    .differentials-section {
      padding: var(--spacing-lg) 0;
    }
  }
</style>
