---
import { CONTACT, ADDRESS, COMPANY } from '../utils/constants';
import WhatsAppIcon from './WhatsAppIcon.astro';

const whatsappUrl = CONTACT.whatsappMessage('iniciar meu projeto');
---

<section class="contact-bar" aria-label="Atendimento rápido">
  <div class="container contact-bar-inner">
    <div class="contact-bar-text">
      <span class="contact-bar-badge">Solicite um Orçamento</span>
      <h2 class="contact-bar-title">Pronto para transformar o seu ambiente?</h2>
      <p class="contact-bar-desc">
        Entre em contato conosco e receba uma consultoria personalizada com projeto 3D para o seu espaço.
      </p>
    </div>

    <div class="contact-bar-actions">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp contact-bar-btn">
        <WhatsAppIcon size={22} />
        Falar no WhatsApp
      </a>
      <a href="/contato" class="btn btn-outline contact-bar-secondary">
        Formulário de Contato
      </a>
    </div>
  </div>
</section>

<style>
  .contact-bar {
    background-color: var(--color-sand);
    padding: var(--spacing-lg) 0;
    border-top: 1px solid rgba(197, 164, 109, 0.2);
  }

  .contact-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    background: var(--color-white);
    padding: 2.5rem 3rem;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .contact-bar-badge {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
  }

  .contact-bar-title {
    font-family: var(--font-section);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    color: var(--color-text);
    margin: 0.25rem 0 0.5rem 0;
  }

  .contact-bar-desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 550px;
  }

  .contact-bar-actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .contact-bar-btn {
    font-size: 0.9rem;
    padding: 0.85rem 1.75rem;
  }

  .contact-bar-secondary {
    font-size: 0.9rem;
    padding: 0.85rem 1.5rem;
  }

  @media (max-width: 992px) {
    .contact-bar-inner {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }

    .contact-bar-actions {
      flex-direction: column;
      width: 100%;
    }

    .contact-bar-actions .btn {
      width: 100%;
    }
  }
</style>
