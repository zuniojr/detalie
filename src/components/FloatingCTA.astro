---
import { CONTACT } from '../utils/constants';

interface Props {
  context?: string;
}

const { context } = Astro.props;
---

<div class="floating-cta-wrapper">
  <!-- Tooltip Bubble -->
  <div class="floating-tooltip">
    <span>Precisa de um orçamento?</span>
  </div>

  <!-- WhatsApp Button -->
  <a
    href="https://bitlybr.net/Detalie"
    class="floating-cta"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Conversar no WhatsApp com a Detaliê Móveis"
  >
    <svg viewBox="0 0 48 48" width="36" height="36" aria-hidden="true">
      <circle cx="24" cy="24" r="24" fill="#25D366"/>
      <path d="M24 10.5c-7.456 0-13.5 6.044-13.5 13.5 0 2.382.618 4.709 1.793 6.764L10.5 37.5l6.936-1.82A13.44 13.44 0 0 0 24 37.5c7.456 0 13.5-6.044 13.5-13.5S31.456 10.5 24 10.5zm6.72 18.78c-.285.8-1.656 1.53-2.285 1.602-.596.068-1.35.097-2.177-.137a19.91 19.91 0 0 1-1.97-.73c-3.467-1.496-5.73-4.997-5.904-5.23-.174-.232-1.422-1.89-1.422-3.605s.9-2.558 1.218-2.907c.318-.35.695-.437.926-.437.232 0 .463.002.666.012.214.01.5-.081.783.597.285.684.968 2.364 1.053 2.535.086.172.143.374.029.604-.115.232-.172.374-.344.578-.172.2-.362.449-.518.603-.172.172-.35.358-.15.703.2.344.89 1.468 1.91 2.378 1.314 1.17 2.422 1.532 2.766 1.704.344.172.545.143.745-.086.2-.232.858-.998 1.086-1.342.23-.344.458-.286.773-.172.318.115 2.008.947 2.352 1.12.344.17.574.258.66.4.085.143.085.83-.2 1.63z" fill="white"/>
    </svg>
  </a>
</div>

<style>
  .floating-cta-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .floating-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #25D366;
    color: var(--color-white);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
    transition: var(--transition);
    animation: whatsapp-pulse 2s infinite;
    position: relative;
  }

  .floating-cta svg circle {
    display: none;
  }

  .floating-cta svg {
    width: 36px;
    height: 36px;
  }

  .floating-cta:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 24px rgba(37, 211, 102, 0.6);
  }

  @keyframes whatsapp-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
    }
    70% {
      box-shadow: 0 0 0 18px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  .floating-tooltip {
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(10px);
    transition: var(--transition);
    pointer-events: none;
    position: relative;
  }

  .floating-tooltip::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    border-width: 6px 0 6px 6px;
    border-style: solid;
    border-color: transparent transparent transparent var(--color-primary);
  }

  .floating-cta-wrapper:hover .floating-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 768px) {
    .floating-cta-wrapper {
      bottom: 20px;
      right: 20px;
    }

    .floating-cta {
      width: 56px;
      height: 56px;
    }

    .floating-cta svg {
      width: 30px;
      height: 30px;
    }

    .floating-tooltip {
      display: none;
    }
  }
</style>
