---
import Layout from '@/layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Differentials from '../components/Differentials.astro';
import Gallery from '../components/Gallery.astro';
import ImpactBanner from '../components/ImpactBanner.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactBar from '../components/ContactBar.astro';
import { getLocalBusinessSchema } from '../utils/schema';
import { COMPANY, SITE } from '../utils/constants';

const localBusinessSchema = getLocalBusinessSchema();
---

<Layout
  title={`${COMPANY.name} | Móveis Planejados em Navegantes e Região`}
  description={COMPANY.description}
  canonical="/"
  jsonLd={localBusinessSchema}
>
  <!-- Hero Section -->
  <Hero />

  <!-- Seção de Diferenciais (6 pilares) -->
  <Differentials />

  <!-- Banner de Atendimento e Projeto 3D -->
  <ImpactBanner
    pretext="Compromisso & Qualidade"
    text="OFERECEMOS EXCELENTE ATENDIMENTO DA CRIAÇÃO DO PROJETO 3D ATÉ A ENTREGA FINAL DO SEU MÓVEL."
  />

  <!-- Primeira Metade do Portfólio (6 categorias) -->
  <Gallery limit={6} offset={0} />

  <!-- Banner de Encaixe Perfeito -->
  <ImpactBanner
    pretext="Personalização Sob Medida"
    text="MÓVEIS QUE SE ENCAIXAM PERFEITAMENTE NA SUA VIDA E NA SUA CASA."
    ctaText="Solicite seu Orçamento Sem Compromisso"
    ctaHref="https://bitlybr.net/Detalie"
  />

  <!-- Segunda Metade do Portfólio (6 categorias) -->
  <Gallery limit={6} offset={6} showTitle={false} />

  <!-- Barra de Atendimento Rápido -->
  <ContactBar />

  <!-- Depoimentos de Clientes Satifeitos -->
  <Testimonials />
</Layout>
