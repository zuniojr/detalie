---
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Differentials from '../components/Differentials.astro';
import ImpactBanner from '../components/ImpactBanner.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactBar from '../components/ContactBar.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { COMPANY, CONTACT, SITE } from '../utils/constants';
import { getWebPageSchema } from '../utils/schema';

// Importação das fotografias originais em alta resolução
import heroBg from '../assets/images/paineis-ripados-sob-medida-hero.jpg';
import ripadoVertical from '../assets/images/painel-ripado-sala-estar-vertical.jpg';
import ripadoDetalhe from '../assets/images/painel-ripado-decorativo-detalhe.jpg';
import ripadoIntegrado from '../assets/images/cozinha-planejada-detalhe-1.jpeg';
import ripadoIluminado from '../assets/images/painel-ripado-madeira-iluminacao-1.jpg';
import ripadoTv from '../assets/images/painel-ripado-sala-tv-moderno-2.jpg';
import ripadoDivisor from '../assets/images/painel-ripado-divisor-ambientes.jpg';

const pageTitle = `Painéis Ripados Sob Medida em Navegantes | ${COMPANY.name}`;
const pageDescription = 'Descubra a versatilidade dos painéis ripados sob medida da Detaliê em Navegantes. Design contemporâneo, elegância e acabamento impecável para salas, quartos e divisórias.';

const pageSchema = getWebPageSchema({
  title: pageTitle,
  description: pageDescription,
  url: '/paineis-ripados',
});

const faqs = [
  {
    question: 'Em quais ambientes posso utilizar o painel ripado sob medida?',
    answer: 'Os painéis ripados são extremamente versáteis. Podem ser instalados em salas de estar como painel de TV, cabeceiras de cama no quarto, halls de entrada, divisórias vazadas entre ambientes integrados, lavabos e escritórios corporativos.'
  },
  {
    question: 'É possível embutir iluminação em LED no painel ripado?',
    answer: 'Sim! Desenvolvemos projetos com rasgos e perfilados de fita LED oculta ou aparente, criando uma iluminação indireta aconchegante que valoriza as texturas da madeira e transforma o clima do ambiente.'
  },
  {
    question: 'Como é feita a limpeza e manutenção dos painéis ripados?',
    answer: 'A manutenção é muito simples: basta utilizar um espanador de pó ou pano macio levemente umedecido em água. Não utilize produtos abrasivos ou ceras químicas.'
  },
  {
    question: 'Qual o tempo de fabricação e instalação dos painéis?',
    answer: 'A fabricação sob medida e montagem técnica levam em média de 30 a 45 dias úteis, com agendamento prévio, medição rigorosa no local e equipe própria de instalação da Detaliê.'
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/paineis-ripados"
  ogImage="/images/logo.png"
  jsonLd={pageSchema}
>
  <!-- Breadcrumb -->
  <Breadcrumb items={[{ label: 'Painéis Ripados' }]} />

  <!-- Hero Section -->
  <section class="page-hero" aria-label="Apresentação Painéis Ripados Sob Medida">
    <div class="hero-bg-wrapper">
      <Image
        src={heroBg}
        alt="Painéis ripados sob medida de alto padrão instalados pela Detaliê Móveis"
        class="hero-bg-img"
        width={1920}
        height={900}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge">Tendência & Sofisticação</span>
        <h1 class="hero-title">
          PAINÉIS RIPADOS <span class="highlight">SOB MEDIDA</span>
        </h1>
        <p class="hero-subtitle">
          Transforme seus ambientes com móveis planejados de alto padrão – encontre a perfeição em cada detalhe.
        </p>
        <div class="hero-actions">
          <a
            href="https://bitlybr.net/Detalie"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp hero-cta-btn"
          >
            <WhatsAppIcon size={22} />
            Quero um Orçamento
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Apresentação e Texto Original -->
  <section class="intro-section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text-col">
          <span class="badge">Detaliê Móveis Sob Medida</span>
          <h2 class="intro-heading">Versatilidade, Elegância e Conforto para o seu Espaço</h2>
          <p class="lead-text">
            Descubra a versatilidade dos painéis ripados. Combinando design moderno e funcionalidade, nossos móveis sob medida são perfeitos para criar ambientes contemporâneos e aconchegantes.
          </p>
          <p>
            O segredo para transformar qualquer ambiente em um espaço acolhedor e elegante. A Detaliê Móveis Sob Medida oferece soluções versáteis para personalizar seu lar com charme e funcionalidade.
          </p>

          <div class="feature-bullets">
            <div class="bullet-item">
              <span class="bullet-icon">✔</span>
              <div>
                <strong>Design Arquitetônico Moderno:</strong>
                <span>Linhas verticais e horizontais que criam sensação de amplitude e pé-direito elevado.</span>
              </div>
            </div>
            <div class="bullet-item">
              <span class="bullet-icon">✔</span>
              <div>
                <strong>Integração com Iluminação em LED:</strong>
                <span>Cenários de luz aconchegantes embutidos entre as ripas ou nas extremidades.</span>
              </div>
            </div>
            <div class="bullet-item">
              <span class="bullet-icon">✔</span>
              <div>
                <strong>Divisão Leve de Ambientes:</strong>
                <span>Painéis vazados que delimitam cômodos preservando a ventilação e a claridade natural.</span>
              </div>
            </div>
          </div>

          <div class="intro-action">
            <a
              href="https://bitlybr.net/Detalie"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <WhatsAppIcon size={20} />
              Solicitar Orçamento no WhatsApp
            </a>
          </div>
        </div>

        <div class="intro-card-col">
          <div class="highlight-box">
            <h3>Por Que Escolher os Ripados da Detaliê?</h3>
            <p>
              Produzimos ripados com espaçamento rigorosamente milimétrico, madeira selecionada e MDF de primeira qualidade. Nada de ripas desalinhadas ou empenadas: você recebe acabamento fino e precisão técnica.
            </p>
            <div class="stats-mini">
              <div class="stat-mini-box">
                <span class="stat-val">100%</span>
                <span class="stat-lbl">Sob Medida</span>
              </div>
              <div class="stat-mini-box">
                <span class="stat-val">LED</span>
                <span class="stat-lbl">Integrado</span>
              </div>
              <div class="stat-mini-box">
                <span class="stat-val">Rigor</span>
                <span class="stat-lbl">No Prazo</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Galeria de Projetos Reais (3 Fotos Verticais Originais) -->
  <section class="gallery-showcase-section">
    <div class="container">
      <SectionTitle
        pretitle="Projetos Reais"
        title="Painéis Ripados Instalados"
        subtitle="Confira a elegância visual e a riqueza de texturas aplicadas em projetos residenciais reais."
      />

      <div class="photos-grid-triad">
        <div class="photo-card">
          <div class="photo-wrapper">
            <Image
              src={ripadoVertical}
              alt="Painel ripado vertical de chão ao teto para sala de estar sofisticada em Navegantes"
              width={600}
              height={900}
              loading="lazy"
            />
          </div>
          <div class="photo-info">
            <h3>Pé-Direito Valorizado</h3>
            <p>Ripas alinhadas do piso ao teto criando volume e sensação de sofisticação contínua.</p>
          </div>
        </div>

        <div class="photo-card">
          <div class="photo-wrapper">
            <Image
              src={ripadoDetalhe}
              alt="Acabamento refinado de ripas de madeira sob medida para hall e salas de estar"
              width={600}
              height={900}
              loading="lazy"
            />
          </div>
          <div class="photo-info">
            <h3>Precisão e Acabamento Fino</h3>
            <p>Encaixes milimétricos com junções imperceptíveis e textura nobre ao toque.</p>
          </div>
        </div>

        <div class="photo-card">
          <div class="photo-wrapper">
            <Image
              src={ripadoIntegrado}
              alt="Painel ripado com integração de móveis planejados em ambiente contemporâneo"
              width={600}
              height={900}
              loading="lazy"
            />
          </div>
          <div class="photo-info">
            <h3>Integração com Mobiliário</h3>
            <p>Harmonização entre ripados decorativos e armários funcionais sob medida.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Diferenciais da Detaliê (6 diferenciais com o novo ícone do calendário) -->
  <Differentials />

  <!-- Destaques de Acabamento (2 Fotos Horizontais + 1 Foto Vertical) -->
  <section class="extended-showcase-section">
    <div class="container">
      <SectionTitle
        pretitle="Aplicações Versáteis"
        title="Ripados que Transformam Qualquer Cômodo"
        subtitle="Do home theater à divisória de ambientes, o ripado traz personalidade e calor ao design."
      />

      <div class="extended-grid">
        <div class="extended-col-wide">
          <div class="wide-photo-card">
            <Image
              src={ripadoIluminado}
              alt="Painel ripado de madeira com iluminação em LED e nichos decorativos sob medida"
              width={1024}
              height={500}
              loading="lazy"
            />
            <div class="wide-caption">
              <h3>Iluminação Indireta em LED</h3>
              <p>Destaque especial para as ripas durante a noite, criando um clima acolhedor e intimista.</p>
            </div>
          </div>

          <div class="wide-photo-card">
            <Image
              src={ripadoTv}
              alt="Home theater com painel ripado sob medida e rack moderno em Navegantes"
              width={1024}
              height={500}
              loading="lazy"
            />
            <div class="wide-caption">
              <h3>Painel de TV & Home Theater</h3>
              <p>Ocultamento total de cabos e fiações com suporte seguro para televisores de grandes polegadas.</p>
            </div>
          </div>
        </div>

        <div class="extended-col-tall">
          <div class="tall-photo-card">
            <Image
              src={ripadoDivisor}
              alt="Painel ripado vazado utilizado como divisória elegante de ambientes"
              width={600}
              height={1000}
              loading="lazy"
            />
            <div class="tall-caption">
              <h3>Divisórias Vazadas</h3>
              <p>Separação visual entre sala e jantar ou cozinha sem perder a circulação de luz e ventilação.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner de Impacto -->
  <ImpactBanner
    pretext="Atendimento & Qualidade"
    text="OFERECEMOS EXCELENTE ATENDIMENTO, PRODUTOS DE QUALIDADE, ALÉM DE INSTALAÇÃO RÁPIDA E PERFEITA."
    ctaText="ENTRE EM CONTATO"
    ctaHref="https://bitlybr.net/Detalie"
  />

  <!-- Seção de Perguntas Frequentes -->
  <section class="faqs-section">
    <div class="container">
      <SectionTitle
        pretitle="Tire Suas Dúvidas"
        title="Perguntas Frequentes sobre Painéis Ripados"
        subtitle="Confira as principais dúvidas sobre materiais, instalação e manutenção."
      />
      <div class="faq-wrapper-card">
        <FAQAccordion faqs={faqs} title="" />
      </div>
    </div>
  </section>

  <!-- Você Também Vai Amar (Outros Ambientes / Portfólio) -->
  <section class="other-environments-section">
    <div class="container">
      <SectionTitle
        pretitle="Você Também Vai Amar"
        title="Outros Ambientes Planejados Detaliê"
        subtitle="Conheça mais ambientes exclusivos fabricados com a mesma precisão e sofisticação."
      />
      <Gallery limit={6} offset={3} showTitle={false} />
    </div>
  </section>

  <!-- Depoimentos -->
  <Testimonials />

  <!-- Barra de Atendimento / Contato Rápido -->
  <ContactBar />
</Layout>

<style>
  /* ===================================================
     HERO SECTION
     =================================================== */
  .page-hero {
    position: relative;
    min-height: 75vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-white);
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(4, 5, 6, 0.88) 0%,
      rgba(28, 26, 23, 0.78) 50%,
      rgba(4, 5, 6, 0.88) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 1;
    padding-top: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
  }

  .hero-content {
    max-width: 780px;
  }

  .hero-badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(197, 164, 109, 0.15);
    border: 1px solid rgba(197, 164, 109, 0.35);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-family: var(--font-section);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    color: var(--color-white);
    letter-spacing: 1px;
    margin-bottom: 1.25rem;
  }

  .hero-title .highlight {
    color: var(--color-accent);
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-cta-btn {
    padding: 1rem 2rem;
    font-size: 1.05rem;
    box-shadow: 0 10px 25px rgba(37, 211, 102, 0.35);
  }

  /* ===================================================
     INTRO SECTION
     =================================================== */
  .intro-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .intro-heading {
    font-family: var(--font-section);
    font-size: clamp(2rem, 3.5vw, 2.7rem);
    color: var(--color-black);
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: 0.5px;
  }

  .lead-text {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--color-text);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .intro-text-col p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .feature-bullets {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 2rem 0;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .bullet-item strong {
    color: var(--color-black);
    display: block;
    font-size: 1rem;
    margin-bottom: 0.15rem;
  }

  .bullet-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.15);
    color: var(--color-whatsapp-hover);
    font-size: 0.85rem;
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .intro-action {
    margin-top: 2rem;
  }

  .highlight-box {
    background: var(--color-offwhite);
    border: 1px solid rgba(197, 164, 109, 0.25);
    border-radius: var(--radius-xl);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .highlight-box h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: var(--color-black);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .highlight-box p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .stats-mini {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding-top: 1.5rem;
  }

  .stat-val {
    display: block;
    font-family: var(--font-section);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .stat-lbl {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-muted);
    font-family: var(--font-heading);
  }

  /* ===================================================
     GALERIA TRIADE (3 Fotos Verticais)
     =================================================== */
  .gallery-showcase-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-sand);
  }

  .photos-grid-triad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .photo-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .photo-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }

  .photo-wrapper {
    overflow: hidden;
    aspect-ratio: 9 / 14;
  }

  .photo-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-card:hover .photo-wrapper :global(img) {
    transform: scale(1.06);
  }

  .photo-info {
    padding: 1.5rem;
  }

  .photo-info h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .photo-info p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ===================================================
     EXTENDED SHOWCASE (2 Horizontais + 1 Vertical)
     =================================================== */
  .extended-showcase-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  .extended-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 2rem;
    align-items: stretch;
  }

  .extended-col-wide {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .wide-photo-card {
    background: var(--color-offwhite);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.06);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .wide-photo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .wide-photo-card :global(img) {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  .wide-caption {
    padding: 1.25rem 1.5rem;
  }

  .wide-caption h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-black);
    margin-bottom: 0.35rem;
  }

  .wide-caption p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .tall-photo-card {
    background: var(--color-offwhite);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.06);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }

  .tall-photo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .tall-photo-card :global(img) {
    width: 100%;
    height: calc(100% - 90px);
    min-height: 520px;
    object-fit: cover;
  }

  .tall-caption {
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }

  .tall-caption h3 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-black);
    margin-bottom: 0.35rem;
  }

  .tall-caption p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* ===================================================
     FAQS & OTHER ENVIRONMENTS
     =================================================== */
  .faqs-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-offwhite);
  }

  .faq-wrapper-card {
    max-width: 860px;
    margin: 0 auto;
    background: var(--color-white);
    padding: 2.5rem 3rem;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .other-environments-section {
    padding: var(--spacing-xl) 0;
    background-color: var(--color-white);
  }

  /* ===================================================
     RESPONSIVIDADE
     =================================================== */
  @media (max-width: 992px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .photos-grid-triad {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .extended-grid {
      grid-template-columns: 1fr;
    }

    .tall-photo-card :global(img) {
      height: 380px;
