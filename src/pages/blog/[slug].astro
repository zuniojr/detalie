---
import { getCollection, render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import ContactBar from '../../components/ContactBar.astro';
import { COMPANY, SITE, getAuthorInfo } from '../../utils/constants';
import { getPostMeta } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => {
    const id = p.id;
    // Excluir rascunhos e posts com slug que contém barras (incompatível com [slug])
    return !id.startsWith('_drafts') && !id.includes('_drafts/');
  });

  const allMetas = posts.map((p) => getPostMeta(p));

  return posts.map((post) => {
    const meta = getPostMeta(post);
    // Filtrar posts relacionados (com tags semelhantes ou mais recentes)
    const relatedPosts = allMetas
      .filter((p) => p.slug !== meta.slug)
      .sort((a, b) => {
        const aMatch = a.tags.some((t) => meta.tags.includes(t)) ? 1 : 0;
        const bMatch = b.tags.some((t) => meta.tags.includes(t)) ? 1 : 0;
        return bMatch - aMatch;
      })
      .slice(0, 3);

    return {
      params: { slug: meta.slug },
      props: { post, meta, relatedPosts },
    };
  });
}

const { post, meta, relatedPosts } = Astro.props;
const { Content } = await render(post);

const authorInfo = getAuthorInfo(meta.author);

const formattedDate = new Date(meta.pubDate).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

// Extrair headings h2/h3 do body do post para o sumário (TOC)
interface TocItem {
  depth: number;
  text: string;
  slug: string;
}

const tocItems: TocItem[] = [];
if (post.body) {
  const headingRegex = /^(#{2,3})\s+(.+)$/gm;
  let match;
  while ((match = headingRegex.exec(post.body)) !== null) {
    const depth = match[1].length;
    const text = match[2].replace(/[*_`\[\]]/g, '').trim();
    const slug = text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
    tocItems.push({ depth, text, slug });
  }
}

// URL do post para compartilhamento
const postUrl = `${SITE.url}/blog/${meta.slug}`;

// JSON-LD Article Schema (melhorado)
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: meta.title,
  description: meta.description,
  image: meta.coverImage.startsWith('http') ? meta.coverImage : `${SITE.url}${meta.coverImage}`,
  datePublished: new Date(meta.pubDate).toISOString(),
  dateModified: new Date(meta.pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: authorInfo.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: COMPANY.name,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}${SITE.ogImage}`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};
---

<Layout
  title={`${meta.title} | Blog ${COMPANY.name}`}
  description={meta.description}
  canonical={`/blog/${meta.slug}`}
  ogImage={meta.coverImage}
  ogType="article"
  jsonLd={articleSchema}
>
  <Breadcrumb
    items={[
      { label: 'Blog', href: '/blog' },
      { label: meta.title },
    ]}
  />

  <article class="article-page">
    <!-- Header do Artigo -->
    <header class="article-header">
      <div class="container text-center">
        {meta.tags.length > 0 && (
          <div class="article-tags">
            {meta.tags.slice(0, 3).map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        )}

        <h1 class="article-title">{meta.title}</h1>

        <div class="article-meta">
          <span>✍️ Por {authorInfo.name}</span>
          <span>•</span>
          <span>⏱️ {meta.readTime}</span>
        </div>
      </div>
    </header>

    <!-- Imagem de Capa -->
    {meta.coverImage && (
      <div class="container article-cover-container">
        <img
          src={meta.coverImage}
          alt={meta.title}
          class="article-cover-img"
          width="1000"
          height="500"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    )}

    <!-- Layout com TOC + Conteúdo -->
    <div class="container article-layout">
      <!-- TOC Mobile (Collapse) -->
      {tocItems.length > 2 && (
        <details class="toc-mobile" id="toc-mobile">
          <summary class="toc-mobile-toggle">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="15" y2="12"/><line x1="3" y1="18" x2="9" y2="18"/>
            </svg>
            Sumário do Artigo
          </summary>
          <nav class="toc-mobile-nav" aria-label="Sumário do artigo">
            <ol class="toc-list">
              {tocItems.map((item) => (
                <li class={`toc-item toc-depth-${item.depth}`}>
                  <a href={`#${item.slug}`} class="toc-link">{item.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}

      <!-- Conteúdo + Sidebar -->
      <div class="article-grid">
        <!-- Conteúdo Principal -->
        <div class="article-body-container">
          <div class="article-content">
            <Content />
          </div>

          <!-- Botões de Compartilhamento -->
          <div class="share-section" aria-label="Compartilhar artigo">
            <span class="share-label">Compartilhe este artigo</span>
            <div class="share-buttons">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(meta.title)}&url=${encodeURIComponent(postUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-btn share-x"
                title="Compartilhar no X/Twitter"
                aria-label="Compartilhar no X/Twitter"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-btn share-linkedin"
                title="Compartilhar no LinkedIn"
                aria-label="Compartilhar no LinkedIn"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              </a>
              <a
                href={`https://api.whatsapp.com/send?text=${encodeURIComponent(meta.title + ' — ' + postUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="share-btn share-whatsapp"
                title="Compartilhar no WhatsApp"
                aria-label="Compartilhar no WhatsApp"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </a>
              <button
                class="share-btn share-copy"
                id="copy-link-btn"
                title="Copiar link"
                aria-label="Copiar link do artigo"
                data-url={postUrl}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon-copy">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                </svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="icon-check" style="display:none;">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Card do Autor -->
          <div class="author-card">
            <img
              src={authorInfo.avatar}
              alt={`Avatar de ${authorInfo.name}`}
              class="author-avatar"
              width="72"
              height="72"
              loading="lazy"
            />
            <div class="author-info">
              <span class="author-label">Escrito por</span>
              <strong class="author-name">{authorInfo.name}</strong>
              <p class="author-bio">{authorInfo.bio}</p>
            </div>
          </div>

          <!-- Voltar ao Blog -->
          <div class="article-footer-nav">
            <a href="/blog" class="btn btn-outline">&larr; Voltar para o Blog</a>
          </div>
        </div>

        <!-- TOC Desktop (Sticky Sidebar) -->
        {tocItems.length > 2 && (
          <aside class="toc-sidebar" aria-label="Sumário">
            <nav class="toc-sidebar-nav">
              <span class="toc-sidebar-title">Neste Artigo</span>
              <ol class="toc-list" id="toc-desktop-list">
                {tocItems.map((item) => (
                  <li class={`toc-item toc-depth-${item.depth}`}>
                    <a href={`#${item.slug}`} class="toc-link">{item.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )}
      </div>
    </div>
  </article>

  <!-- Seção de Artigos Relacionados -->
  {relatedPosts.length > 0 && (
    <section class="related-posts-section">
      <div class="container">
        <div class="related-header">
          <span class="badge-sub">Recomendados para você</span>
          <h2 class="related-title">Artigos Relacionados</h2>
        </div>
        <div class="related-grid">
          {relatedPosts.map((rel) => (
            <BlogPostCard
              title={rel.title}
              description={rel.description}
              slug={rel.slug}
              pubDate={rel.pubDate}
              author={rel.author}
              coverImage={rel.coverImage}
              tags={rel.tags}
              readTime={rel.readTime}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <ContactBar />
</Layout>

<script>
  function initSinglePost() {
    // === TOC Active Highlight via Intersection Observer ===
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length > 0) {
      const headingIds = Array.from(tocLinks).map((link) => {
        const href = link.getAttribute('href');
        return href ? href.slice(1) : '';
      });

      const headings = headingIds
        .map((id) => document.getElementById(id))
        .filter(Boolean) as HTMLElement[];

      if (headings.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.id;
                tocLinks.forEach((link) => {
                  const linkId = link.getAttribute('href')?.slice(1);
                  link.classList.toggle('active', linkId === id);
                });
              }
            });
          },
          {
            rootMargin: '-80px 0px -60% 0px',
            threshold: 0,
          }
        );

        headings.forEach((h) => observer.observe(h));
      }
    }

    // === TOC Mobile: fechar ao clicar em um link ===
    const tocMobile = document.getElementById('toc-mobile') as HTMLDetailsElement | null;
    if (tocMobile) {
      tocMobile.querySelectorAll('.toc-link').forEach((link) => {
        link.addEventListener('click', () => {
          tocMobile.open = false;
        });
      });
    }

    // === Copiar Link ===
    const copyBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.dataset.url || window.location.href;

        // Tentar Web Share API em mobile
        if (navigator.share && /Mobi|Android/i.test(navigator.userAgent)) {
          try {
            await navigator.share({
              title: document.title,
              url: url,
            });
            return;
          } catch {
            // Usuário cancelou ou API falhou — fallback para copiar
          }
        }

        // Copiar para clipboard
        try {
          await navigator.clipboard.writeText(url);
          const iconCopy = copyBtn.querySelector('.icon-copy') as HTMLElement;
          const iconCheck = copyBtn.querySelector('.icon-check') as HTMLElement;
          if (iconCopy && iconCheck) {
            iconCopy.style.display = 'none';
            iconCheck.style.display = 'block';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              iconCopy.style.display = 'block';
              iconCheck.style.display = 'none';
              copyBtn.classList.remove('copied');
            }, 2000);
          }
        } catch {
          // Fallback: prompt
          window.prompt('Copie o link:', url);
        }
      });
    }
  }

  initSinglePost();
  document.addEventListener('astro:page-load', initSinglePost);
</script>

<style>
  .article-page {
    padding-bottom: var(--spacing-xl);
    background-color: var(--color-white);
  }

  .article-header {
    padding: var(--spacing-lg) 0 var(--spacing-md) 0;
  }

  .text-center {
    text-align: center;
  }

  .article-tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag-pill {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .article-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    max-width: 850px;
    margin: 0 auto 1rem auto;
    line-height: 1.25;
  }

  .article-meta {
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* === Imagem de Capa === */
  .article-cover-container {
    max-width: 1000px;
    margin-bottom: 3rem;
  }

  .article-cover-img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  /* === Layout Grid: Conteúdo + TOC Sidebar === */
  .article-layout {
    max-width: 1100px;
  }

  .article-grid {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: 3rem;
    align-items: start;
  }

  .article-body-container {
    min-width: 0;
    max-width: 780px;
  }

  /* === Conteúdo do Artigo === */
  .article-content {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .article-content :global(h2) {
    font-family: var(--font-section);
    font-size: 1.75rem;
    margin: 2.25rem 0 1rem 0;
    color: var(--color-primary);
    scroll-margin-top: 100px;
  }

  .article-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    margin: 1.75rem 0 0.75rem 0;
    color: var(--color-primary);
    scroll-margin-top: 100px;
  }

  .article-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
  }

  .article-content :global(li) {
    margin-bottom: 0.5rem;
  }

  /* Imagens dentro do conteúdo Markdown */
  .article-content :global(img) {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    margin: 1.5rem 0;
    width: 100%;
    height: auto;
  }

  .article-content :global(figure) {
    margin: 2rem 0;
  }

  .article-content :global(figcaption) {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .article-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: var(--color-accent-soft);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .article-content :global(code) {
    background: var(--color-sand);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: var(--transition-fast);
  }

  .article-content :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* === TOC Sidebar (Desktop) === */
  .toc-sidebar {
    display: block;
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .toc-sidebar-nav {
    padding: 1.25rem;
    background: var(--color-offwhite);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .toc-sidebar-title {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-depth-3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.35rem 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
    transition: var(--transition-fast);
    line-height: 1.4;
  }

  .toc-link:hover {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .toc-link:global(.active) {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: var(--color-accent-soft);
    font-weight: 600;
  }

  /* === TOC Mobile (Collapse) === */
  .toc-mobile {
    display: none;
    margin-bottom: 2rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-md);
    background: var(--color-offwhite);
    overflow: hidden;
  }

  .toc-mobile-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .toc-mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-toggle svg {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .toc-mobile-nav {
    padding: 0 1.25rem 1rem 1.25rem;
  }

  /* === Botões de Compartilhamento === */
  .share-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-label {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text-muted);
  }

  .share-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
